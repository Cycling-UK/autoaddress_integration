<?php

/**
 * @file
 * Primary module hooks for Autoaddress Integration module.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function autoaddress_integration_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // This looks for any webform submission form. 
  // You can also use: if ($form_id == 'webform_submission_YOUR_FORM_ID_add_form') 
  if (strpos($form_id, 'webform_submission') !== FALSE) {
    // 1. Attach your frontend library SDK.
    $form['#attached']['library'][] = 'autoaddress_integration/autoaddress-sdk';

    // 2. Load the configuration that was set by getenv() in settings.local.php.
    $config = \Drupal::config('autoaddress_integration.settings');
    $api_key = $config->get('api_key') ?: '';

    // 3. Pass the API key to the frontend via drupalSettings.
    $form['#attached']['drupalSettings']['autoaddressIntegration']['apiKey'] = $api_key;
  }
}