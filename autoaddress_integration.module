<?php

/**
 * @file
 * Primary module hooks for Autoaddress Integration module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\csp\Csp;


/**
 * Implements hook_csp_policy_alter().
 *
 * Automatically bundles Autoaddress CSP requirements into the site's policy.
 */
function autoaddress_integration_csp_policy_alter(Csp $policy) {
  // Script fallback (Safe to append because the SDK library won't execute without it)
  if ($policy->hasDirective('script-src')) {
    $policy->fallbackAwareAppendValue('script-src', 'integrations.autoaddress.com');
  }

  // Define the critical directives that need explicit exceptions
  $directives = [
    'connect-src' => ['api.autoaddress.com', 'integrations.autoaddress.com'],
    'frame-src'   => ['integrations.autoaddress.com'],
    'img-src'     => ['integrations.autoaddress.com'],
  ];

  foreach ($directives as $directive => $domains) {
    // If the directive doesn't exist, build it from default-src so we don't cause massive breakages
    if (!$policy->hasDirective($directive)) {
      if ($policy->hasDirective('default-src')) {
        $policy->setDirective($directive, $policy->getDirective('default-src'));
      } else {
        $policy->setDirective($directive, ["'self'"]);
      }
    }

    // Append all required domains safely to the active directive stack
    foreach ($domains as $domain) {
      $policy->appendValue($directive, $domain);
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function autoaddress_integration_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // This looks for any webform submission form. 
  // You can also use: if ($form_id == 'webform_submission_YOUR_FORM_ID_add_form') 
  if (strpos($form_id, 'webform_submission') !== FALSE) {
    // 1. Attach your frontend library SDK.
    $form['#attached']['library'][] = 'autoaddress_integration/autoaddress-sdk';

    // 2. Load the configuration that was set by getenv() in settings.local.php.
    $config = \Drupal::config('autoaddress_integration.settings');
    $api_key = $config->get('api_key') ?: '';

    // 3. Pass the API key to the frontend via drupalSettings.
    $form['#attached']['drupalSettings']['autoaddressIntegration']['apiKey'] = $api_key;
  }
}